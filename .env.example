# Copy to .env for local development. Never commit .env.

# --- Local / CI defaults ---
DEBUG=True
SECRET_KEY=change-me-in-local-dev
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://wccrm:wccrm@127.0.0.1:5432/wccrm
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Lakeside Pane Co. <noreply@lakesidepane.example>
OWNER_NOTIFY_EMAIL=owner@lakesidepane.example
# Shared secret for POST /integrations/leads/ (header: X-Leads-Webhook-Secret)
LEADS_WEBHOOK_SECRET=replace-with-a-long-random-string

# --- Production checklist (generic; no specific host) ---
# DEBUG=False
# SECRET_KEY=<long-random-value>
# ALLOWED_HOSTS=your.domain.example
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.your-provider.example
# EMAIL_PORT=587
# EMAIL_HOST_USER=<smtp-username>
# EMAIL_HOST_PASSWORD=<smtp-password>
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=Lakeside Pane Co. <noreply@your.domain.example>
# OWNER_NOTIFY_EMAIL=you@your.domain.example
# LEADS_WEBHOOK_SECRET=<long-random-value>
